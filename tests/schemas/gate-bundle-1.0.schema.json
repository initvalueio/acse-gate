{
  "$comment": "Derived from ACSE's contract gate-bundle-1.0 (descriptions removed); validation only.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-bundle-1.0.schema.json",
  "title": "ACSE Gate Bundle Control 1.0",
  "type": "object",
  "required": [
    "gate_bundle_version",
    "default_mode"
  ],
  "properties": {
    "gate_bundle_version": {
      "const": "1.0"
    },
    "default_mode": {
      "$ref": "#/$defs/bundleMode"
    },
    "classes": {
      "type": "array",
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bundleClassMode"
      }
    },
    "labels": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bundleLabelScopes"
      }
    },
    "address_hashing": {
      "$ref": "#/$defs/bundleAddressHashing"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bundleMode": {
      "enum": [
        "observe",
        "enforce"
      ]
    },
    "labelDimension": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,62}$"
    },
    "labelValue": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,62}$"
    },
    "bundleLabelMode": {
      "type": "object",
      "required": [
        "dimension",
        "value",
        "mode"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/labelDimension"
        },
        "value": {
          "$ref": "#/$defs/labelValue"
        },
        "mode": {
          "$ref": "#/$defs/bundleMode"
        }
      },
      "additionalProperties": false
    },
    "bundleClassMode": {
      "type": "object",
      "required": [
        "check_id",
        "mode"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,127}$"
        },
        "mode": {
          "$ref": "#/$defs/bundleMode"
        },
        "label_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bundleLabelMode"
          }
        }
      },
      "additionalProperties": false
    },
    "bundleScope": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "gcp_project"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        }
      },
      "additionalProperties": false
    },
    "bundleLabelScopes": {
      "type": "object",
      "required": [
        "dimension",
        "value",
        "scopes"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/labelDimension"
        },
        "value": {
          "$ref": "#/$defs/labelValue"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bundleScope"
          }
        }
      },
      "additionalProperties": false
    },
    "bundleAddressHashing": {
      "type": "object",
      "required": [
        "salt"
      ],
      "properties": {
        "salt": {
          "type": "string",
          "pattern": "^[!-~]{16,256}$"
        }
      },
      "additionalProperties": false
    }
  }
}
