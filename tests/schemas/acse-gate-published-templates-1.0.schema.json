{
  "$comment": "Derived from ACSE's contract acse-gate-published-templates-1.0 (descriptions removed); validation only.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acse-gate-published-templates-1.0.schema.json",
  "title": "ACSE Gate Published Templates 1.0",
  "type": "object",
  "required": [
    "published_templates_version",
    "template_format",
    "releases"
  ],
  "properties": {
    "published_templates_version": {
      "const": "1.0"
    },
    "template_format": {
      "const": "acse-gate-template-1"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/templateRelease"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "releaseState": {
      "enum": [
        "current",
        "withdrawn"
      ]
    },
    "withdrawal": {
      "type": "object",
      "required": [
        "reason",
        "security",
        "effective_on"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "pattern": "^[ -~]{1,500}$"
        },
        "security": {
          "type": "boolean"
        },
        "announced_on": {
          "type": "string",
          "format": "date"
        },
        "effective_on": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "security"
            ],
            "properties": {
              "security": {
                "const": true
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "announced_on"
              ]
            }
          }
        }
      ]
    },
    "templateRelease": {
      "type": "object",
      "required": [
        "release",
        "template_digest",
        "released_on",
        "state"
      ],
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,6}$"
        },
        "template_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "released_on": {
          "type": "string",
          "format": "date"
        },
        "state": {
          "$ref": "#/$defs/releaseState"
        },
        "withdrawal": {
          "$ref": "#/$defs/withdrawal"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "withdrawn"
              }
            }
          },
          "then": {
            "required": [
              "withdrawal"
            ]
          },
          "else": {
            "not": {
              "required": [
                "withdrawal"
              ]
            }
          }
        }
      ]
    }
  }
}
