{
  "bundle_id": "gcp-compute-os-login",
  "bundle_version": "0.1.0",
  "rule_id": "os-login",
  "rule_version": "0.1.0",
  "directive_id": "gcp-compute-os-login",
  "directive_version": "1.0",
  "terraform": {
    "provider_source": "registry.terraform.io/hashicorp/google",
    "provider_version": "6.8.0",
    "bound_resource_type": "google_compute_instance",
    "target": {
      "kind": "standalone",
      "resource_type": "google_compute_project_metadata_item",
      "name": "enable_oslogin",
      "identity": [
        {
          "attribute": "project",
          "group": "project"
        }
      ]
    },
    "changes": [
      {
        "op": "set",
        "path": [
          "key"
        ],
        "value": "enable-oslogin"
      },
      {
        "op": "set",
        "path": [
          "value"
        ],
        "value": "TRUE"
      }
    ],
    "planned_state": {
      "facts": [
        {
          "name": "os_login_enabled",
          "value": true
        }
      ]
    }
  },
  "cli": {
    "gcloud": {
      "commands": [
        [
          "gcloud compute project-info add-metadata --project",
          {
            "group": "project"
          },
          "--metadata",
          {
            "change": 1,
            "format": "enable-oslogin={value}"
          }
        ],
        [
          "gcloud compute instances remove-metadata",
          {
            "group": "name"
          },
          "--zone",
          {
            "group": "zone"
          },
          "--project",
          {
            "group": "project"
          },
          "--keys enable-oslogin"
        ]
      ]
    }
  }
}
