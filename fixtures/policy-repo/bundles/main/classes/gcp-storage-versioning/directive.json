{
  "bundle_id": "gcp-storage-versioning",
  "bundle_version": "0.1.0",
  "rule_id": "storage-versioning",
  "rule_version": "0.1.0",
  "directive_id": "gcp-storage-versioning",
  "directive_version": "1.0",
  "terraform": {
    "provider_source": "registry.terraform.io/hashicorp/google",
    "provider_version": "6.8.0",
    "bound_resource_type": "google_storage_bucket",
    "target": {
      "kind": "bound"
    },
    "changes": [
      {
        "op": "set",
        "path": [
          "versioning",
          "enabled"
        ],
        "value": true,
        "create_missing_blocks": true
      }
    ],
    "planned_state": {
      "facts": [
        {
          "name": "versioning_enabled",
          "value": true
        }
      ]
    }
  },
  "cli": {
    "gcloud": {
      "commands": [
        [
          "gcloud storage buckets update",
          {
            "group": "bucket",
            "prefix": "gs://"
          },
          "--versioning"
        ]
      ]
    }
  }
}
