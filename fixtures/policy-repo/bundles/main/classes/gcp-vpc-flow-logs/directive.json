{
  "bundle_id": "gcp-vpc-flow-logs",
  "bundle_version": "0.1.0",
  "rule_id": "vpc-flow-logs",
  "rule_version": "0.1.0",
  "directive_id": "gcp-vpc-flow-logs",
  "directive_version": "1.0",
  "terraform": {
    "provider_source": "registry.terraform.io/hashicorp/google",
    "provider_version": "6.8.0",
    "bound_resource_type": "google_compute_subnetwork",
    "target": {
      "kind": "bound"
    },
    "changes": [
      {
        "op": "set",
        "path": [
          "log_config",
          "aggregation_interval"
        ],
        "value": "INTERVAL_5_SEC",
        "create_missing_blocks": true
      }
    ],
    "planned_state": {
      "facts": [
        {
          "name": "flow_logs_enabled",
          "value": true
        }
      ]
    }
  },
  "cli": {
    "gcloud": {
      "commands": [
        [
          "gcloud compute networks subnets update",
          {
            "group": "name"
          },
          "--region",
          {
            "group": "region"
          },
          "--project",
          {
            "group": "project"
          },
          "--enable-flow-logs"
        ]
      ]
    }
  }
}
