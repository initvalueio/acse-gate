{
  "bundle_id": "gcp-vpc-firewall-logging",
  "bundle_version": "0.1.0",
  "rule_id": "firewall-logging",
  "rule_version": "0.1.0",
  "directive_id": "gcp-vpc-firewall-logging",
  "directive_version": "1.0",
  "terraform": {
    "provider_source": "registry.terraform.io/hashicorp/google",
    "provider_version": "6.8.0",
    "bound_resource_type": "google_compute_firewall",
    "target": {
      "kind": "bound"
    },
    "changes": [
      {
        "op": "set",
        "path": [
          "log_config",
          "metadata"
        ],
        "value": "INCLUDE_ALL_METADATA",
        "create_missing_blocks": true
      }
    ],
    "planned_state": {
      "facts": [
        {
          "name": "firewall_logging_enabled",
          "value": true
        }
      ]
    }
  },
  "cli": {
    "gcloud": {
      "commands": [
        [
          "gcloud compute firewall-rules update",
          {
            "group": "name"
          },
          "--project",
          {
            "group": "project"
          },
          "--enable-logging",
          "--logging-metadata=include-all"
        ]
      ]
    }
  }
}
